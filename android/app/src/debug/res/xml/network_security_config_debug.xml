<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the instrumented tests of the link-preview fetch talk to a fake web server on this device (a plain socket on 127.0.0.1). The release build has no such file: it allows no cleartext traffic. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
