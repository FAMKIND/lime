<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LIME-103 (the Bluetooth field test): Debug builds only; merged into the generated Info.plist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- LIME-272b: moving to a new phone finds the other phone by Bonjour. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_lime-move._tcp</string>
	</array>
</dict>
</plist>
